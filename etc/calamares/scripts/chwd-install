#!/usr/bin/env bash

set -u

echo "### chwd: ensuring DKMS build prerequisites"

for pkgbase in /usr/lib/modules/*/pkgbase; do
    [ -e "$pkgbase" ] || continue
    kernel="$(cat "$pkgbase")"
    pacman -S --needed --noconfirm "${kernel}-headers" || true
done
pacman -S --needed --noconfirm dkms || true

echo "### chwd: detecting hardware"
chwd -a -f || echo "### chwd: autoconfigure reported an error, continuing"

echo "### chwd: regenerating initramfs"
mkinitcpio -P || true

echo "### chwd: done"
exit 0
